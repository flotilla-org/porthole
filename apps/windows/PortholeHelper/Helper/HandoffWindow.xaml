<Window
    x:Class="Porthole.WindowsHelper.HandoffWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Porthole helper">
    <StackPanel Spacing="18" Padding="24">
        <TextBlock Text="Porthole helper" FontSize="28" />
        <TextBlock Text="Porthole can keep working on this desktop after you leave RDP." TextWrapping="Wrap" />
        <Button x:Name="Handoff" x:FieldModifier="internal" AutomationProperties.Name="Disconnect RDP — keep automation running; requires administrator approval">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE72E;" />
                <TextBlock Text="Disconnect RDP — keep automation running" />
            </StackPanel>
        </Button>
        <TextBlock Text="You stay signed in and the local desktop stays unlocked." TextWrapping="Wrap" />
        <Button x:Name="CancelAttempt" x:FieldModifier="internal" Content="Cancel handoff" IsEnabled="False" />
        <InfoBar x:Name="Status" x:FieldModifier="internal" IsOpen="True" IsClosable="False" Title="Ready"
                 Message="Disconnect RDP when this desktop is available." Severity="Informational" />
    </StackPanel>
</Window>
